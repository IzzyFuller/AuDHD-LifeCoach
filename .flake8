[flake8]
max-line-length = 88
extend-ignore = E203,W503
# Ignore E402 in entrypoint files where we need to modify sys.path first
# Ignore F401 in __init__.py files where imports are used for re-export
per-file-ignores = 
    docker-entrypoint.py:E402
    message_consumer_entrypoint.py:E402
    scripts/debug_ner_pipeline.py:E402
    __init__.py:F401
