# AuDHD-LifeCoach Configuration Example
# Copy this file to .env and configure your values

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=production

# =============================================================================
# RabbitMQ Configuration (REQUIRED)
# =============================================================================
# These settings must be configured to match your external RabbitMQ instance

# RabbitMQ Connection Settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# RabbitMQ Infrastructure Settings (configured by your infrastructure team/Terraform)
# The queue and exchange names should match what was provisioned externally
RABBITMQ_CONSUME_QUEUE=communications
RABBITMQ_PUBLISH_EXCHANGE=audhd_lifecoach

# =============================================================================
# RabbitMQ Connection Tuning (OPTIONAL)
# =============================================================================
# Fine-tune connection behavior if needed
RABBITMQ_CONNECTION_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=2
RABBITMQ_CONNECTION_TIMEOUT=30
RABBITMQ_HEARTBEAT=600

# =============================================================================
# RabbitMQ SSL Configuration (OPTIONAL)
# =============================================================================
# Uncomment and configure if your RabbitMQ uses SSL/TLS
# RABBITMQ_USE_SSL=true
# RABBITMQ_SSL_CA_CERT_PATH=/path/to/ca-cert.pem
# RABBITMQ_SSL_CERT_PATH=/path/to/client-cert.pem
# RABBITMQ_SSL_KEY_PATH=/path/to/client-key.pem

# =============================================================================
# Development/Testing Overrides
# =============================================================================
# For local development, you might want to use these values:
# RABBITMQ_HOST=localhost
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# ENVIRONMENT=development
